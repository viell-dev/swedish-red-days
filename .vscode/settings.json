{
  "editor.rulers": [100, 120],
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.test.ts",
    "package.json": "pnpm-lock.yaml",
    "eslint.config.ts": "prettier.config.js, .prettierignore",
  },
  "cSpell.ignorePaths": [
    "pnpm-lock.yaml",
    "node_modules",
    ".wrangler",
    "dist"
  ],
  "cSpell.ignoreWords": [
    "ALLDAYEVENT",
    "CALNAME",
    "DTSTAMP",
    "DTSTART",
    "MSNCALENDAR",
    "PRODID",
    "VCALENDAR",
    "VEVENT",
    "dtstarts",
    "ical",
    "oxlint",
    "uids",
    "workerd"
  ],
  "cSpell.words": [
    "Alla",
    "allmän",
    "allmänna",
    "Annandag",
    "bebådelsedag",
    "betänkande",
    "computus",
    "dagar",
    "flaggdagar",
    "Första",
    "helgdag",
    "helgdagar",
    "helgons",
    "himmelsfärdsdag",
    "Högtider",
    "innebar",
    "Juldagen",
    "juni",
    "kalenderreformen",
    "klämdagar",
    "Långfredagen",
    "Meeus",
    "metonic",
    "Midsommardagen",
    "nationaldag",
    "Nationaldagen",
    "Nyårsdagen",
    "påsk",
    "Påskdagen",
    "pingst",
    "Pingstdagen",
    "Regeringen",
    "Riksdagen",
    "röda",
    "Söndag",
    "Svenska",
    "Sveriges",
    "traditioner",
    "Trettondedag",
    "Vitest"
  ]
}
